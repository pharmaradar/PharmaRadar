{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"celery -A app.tasks.celery_app.celery_app worker -Q pdf --concurrency=2 --loglevel=info -n pdf@railway -B --max-tasks-per-child=50 --max-memory-per-child=400000\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
